# OpenRouter API Key (supports both Jev Decisions and Grok LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# System-1 Decision Model (Fast sub-150ms typed micro-decisions)
JEV_MODEL=typesafe/jev-1.13

# System-2 Deep Reasoning Model (Escalated negotiation & ambiguous intent)
GROK_MODEL=x-ai/grok-2-1212

# Optional: Supabase & Telemetry (Phase 2 & 4)
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
