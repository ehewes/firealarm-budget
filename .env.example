# Local development settings. Copy to .env (gitignored) and fill in.
#
# Production never reads this file: the values live in GitHub secrets and
# variables, and the deploy workflow renders /opt/firealarm-budget/.env on the
# VPS from them. See docs/secrets.md for what each one is for.
#
# Comments go above keys, never after them: an inline comment would become part
# of the value.

# The public URL of the service. Locally that is the Next dev server.
PUBLIC_BASE_URL=http://localhost:3000

# Where the Next server reaches the API. In compose this is http://api:8000.
API_INTERNAL_URL=http://127.0.0.1:8000

# Postgres for the API and scraper. This is local Supabase's default (`make db`).
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Supabase project URL and publishable (browser-safe) key, used for sign-in.
# `make db-status` prints the local values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Only for projects still signing tokens with the legacy HS256 secret (local
# Supabase does by default). Hosted projects verify through their JWKS instead.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Salt for hashing requester IPs before they are stored. Any random string.
IP_HASH_SALT=change-me-locally

# Bright Data. Leave these blank and keep SCRAPER_FIXTURES set to work offline.
BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=
# host:port:user:pass from the Bright Data dashboard (an ISP zone). Optional.
BRIGHTDATA_PROXY=

# OpenRouter key for Jev (typesafe/jev-1.13). Blank means URL heuristics pick
# the links and rules fall back to keyword matching.
OPENROUTER_API_KEY=

# Offline mode: serve pages from saved fixtures instead of Bright Data.
# Unset it (and set the Bright Data keys) to scrape for real.
SCRAPER_FIXTURES=apps/scraper/tests/fixtures/pages

# Monthly spend caps. Hitting the Jev cap degrades to heuristics; hitting the
# scrape cap refuses new scrapes until the month rolls over.
JEV_MONTHLY_BUDGET_USD=5
SCRAPE_MONTHLY_MAX=5000
