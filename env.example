# ---------- apps/api (server only — never expose) ----------
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

BRIGHTDATA_API_KEY=
BRIGHTDATA_UNLOCKER_ZONE=

JEV_API_KEY=
GROK_API_KEY=

AGENT_CARD_API_KEY=            # stretch
ALLOWED_DOMAINS=joinfleek.com,zara.com,<your-dev-store>.myshopify.com
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=24
SCRAPE_CONCURRENCY=8

# Jev goes through OpenRouter; JEV_API_KEY above is read as the same key if this is unset.
OPENROUTER_API_KEY=
# Where "Continue to Grok" opens (the prompt goes in ?q=), and the model for rule parsing.
GROK_BOT_URL=https://grok.com/
GROK_MODEL=grok-4-fast-non-reasoning
# Public base of the API that Grok is told to call. Defaults to WEB_ORIGIN + /v1.
PUBLIC_API_URL=
# Monthly spend caps (usage_counters). Past them: no new scrapes / Jev falls back to keywords.
SCRAPE_MONTHLY_MAX=5000
JEV_MONTHLY_BUDGET_USD=5
# Reuse windows: share a scrape of the same URL, and reuse cached page HTML.
SCRAPE_FRESH_MINUTES=30
PAGE_CACHE_MINUTES=360
# Product pages fetched per scrape for brand/breadcrumbs/stock (each one counts as a scrape).
MAX_PRODUCT_PAGES=10
# Rate limits on POST /v1/sessions, and the salt for hashing requester IPs (random in production).
SESSIONS_PER_HOUR_PER_IP=20
SESSIONS_PER_HOUR_PER_USER=30
IP_HASH_SALT=change-me
# Offline development: serve saved HTML instead of calling Bright Data (never in production).
# FIXTURES_DIR=tests/fixtures

# ---------- apps/web (safe to expose) ----------
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
NEXT_PUBLIC_GROK_BOT_URL=
